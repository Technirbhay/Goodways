# Backend Private Environment Variables (Never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional: used only to authorize the initial super-admin registration.
ADMIN_INVITE_CODE=replace_with_a_separate_random_invite_code

# Optional public Google Maps key, if the backend config endpoint should provide it.
GOOGLE_MAPS_API_KEY=
PORT=3000
JWT_SECRET=goodways-secure-jwt-secret-key-2026
