# Frontend Public Environment Variables (Safe for browser exposure)
VITE_GOOGLE_MAPS_API_KEY=your_public_google_maps_api_key_here

# Render backend URL in production; leave blank for the local Vite proxy.
VITE_API_BASE_URL=

# Firebase web configuration. Restrict the API key by HTTP referrer in Google Cloud.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
